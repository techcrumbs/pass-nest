{
  "name": "pass-nest",
  "version": "0.0.1",
  "description": "Local-first desktop password manager built with Electron and TypeScript",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "npm run build && npm run generate:icons && electron-builder",
    "dist:mac": "npm run build && npm run generate:icons && electron-builder --mac",
    "dist:win": "npm run build && npm run generate:icons && electron-builder --win",
    "generate:icons": "python3 scripts/generate-icons.py",
    "pack": "npm run build && npm run generate:icons && electron-builder --dir",
    "start": "npm run build && electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techcrumbs/pass-nest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/techcrumbs/pass-nest/issues"
  },
  "homepage": "https://github.com/techcrumbs/pass-nest#readme",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "electron": "^41.1.1",
    "electron-builder": "^26.9.0",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.techcrumbs.passnest",
    "productName": "PassNest",
    "directories": {
      "buildResources": "build/icons",
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "passnest.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "passnest.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    },
    "npmRebuild": false
  }
}
